    <item>
      <title>@GitHub in Slack and Teams reaches GA: the bot investigates bugs, creates issues and opens pull requests straight from a thread</title>
      <link>https://github.blog/changelog/2026-11-06-github-copilot-in-slack-and-teams-is-generally-available/</link>
      <guid isPermaLink="true">https://github.blog/changelog/2026-11-06-github-copilot-in-slack-and-teams-is-generally-available/</guid>
      <pubDate>Sun, 08 Nov 2026 04:00:00 -0800</pubDate>
